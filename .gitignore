# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter artifacts
.ipynb_checkpoints/

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS/editor files
.DS_Store
Thumbs.db
.vscode/

# Secrets and local environment
.env
.env.*
!.env.example
secrets*.json

# Data and model artifacts (keep processed docs/notebooks tracked)
data/raw/*
!data/raw/README.md
data/interim/
cache/
/models/

# Generated figures (keep the folder, ignore outputs by default)
reports/figures/*
!reports/figures/.gitkeep

# uv
.python-version
